    {
        "id": "87711bd8e036962f",
        "type": "function",
        "z": "b45586208d9ee7b7",
        "name": "function 27",
        "func": "let payload = msg.payload;\nif (typeof payload === 'string') {\n    try { payload = JSON.parse(payload); } catch (e) { return null; }\n}\n\n// Prüfen, ob ENERGY.Current im Payload vorhanden ist\nif (payload && payload.ENERGY && payload.ENERGY.Current !== undefined) {\n    let currentA = payload.ENERGY.Current;\n    // Wir geben nur den gerundeten Wert als Zahl zurück\n    msg.payload = currentA.toFixed(2); \n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 740,
        "wires": [
            [
                "cf49cb9f38f81b4f"
            ]
        ]
    },
    {
        "id": "6eb60a0941f7b759",
        "type": "function",
        "z": "b45586208d9ee7b7",
        "name": "function 28",
        "func": "// --- VOLLSTÄNDIGE E-BIKE STEUERUNGS- UND SCHUTZLOGIK ---\nlet msgTopic = msg.topic || \"\";\nlet payload = msg.payload;\n\nlet mode = flow.get(\"ebike_mode\") || \"OFF\";          \nlet excessActive = flow.get(\"ebike_excess\") || false;\nlet cutoffAmps = flow.get(\"ebike_cutoff\") || 0.5;      \nlet intervalMin = flow.get(\"ebike_interval\") || 5;     \n\nfunction parseJson(data) {\n    if (typeof data === 'string') {\n        try { data = JSON.parse(data); } catch (e) { return null; }\n    }\n    return data;\n}\n\n// --- 1. WIDGETS & SCHALTER VOM DASHBOARD VERARBEITEN ---\n\nif (msgTopic === \"set_aus\") {\n    flow.set(\"ebike_mode\", \"OFF\");\n    flow.set(\"ebike_excess\", false);\n    flow.set(\"ebike_start_time\", null);\n    node.status({ fill: \"red\", shape: \"ring\", text: \"Modus: Manuell AUS\" });\n    return { topic: \"cmnd/ebike/POWER\", payload: \"OFF\" }; \n}\n\nif (msgTopic === \"set_voll\") {\n    flow.set(\"ebike_mode\", \"FULL\");\n    flow.set(\"ebike_excess\", false);\n    flow.set(\"ebike_start_time\", null);\n    node.status({ fill: \"green\", shape: \"dot\", text: \"Modus: Voll-Laden aktiv\" });\n    return { topic: \"cmnd/ebike/POWER\", payload: \"ON\" }; \n}\n\nif (msgTopic === \"set_teilladen\") {\n    flow.set(\"ebike_mode\", \"PARTIAL\");\n    flow.set(\"ebike_excess\", false);\n    flow.set(\"ebike_start_time\", Date.now()); \n    node.status({ fill: \"blue\", shape: \"dot\", text: \"Modus: Teilladen (Anlaufphase 5 Min...)\" });\n    return { topic: \"cmnd/ebike/POWER\", payload: \"ON\" }; \n}\n\nif (msgTopic === \"set_excess_switch\") {\n    excessActive = Boolean(payload);\n    flow.set(\"ebike_excess\", excessActive);\n    if (excessActive) {\n        flow.set(\"ebike_mode\", \"OFF\");\n        node.status({ fill: \"green\", shape: \"ring\", text: \"Überschussladen eingeschaltet\" });\n        return null; \n    } else {\n        node.status({ fill: \"red\", shape: \"ring\", text: \"Überschussladen AUS\" });\n        return { topic: \"cmnd/ebike/POWER\", payload: \"OFF\" };\n    }\n}\n\nif (msgTopic === \"set_cutoff_input\") {\n    flow.set(\"ebike_cutoff\", Number(payload));\n    node.status({ fill: \"grey\", shape: \"dot\", text: `Abschaltstrom gesetzt: ${payload}A` });\n    return null;\n}\n\nif (msgTopic === \"set_interval_input\") {\n    flow.set(\"ebike_interval\", Number(payload));\n    node.status({ fill: \"grey\", shape: \"dot\", text: `Intervall gesetzt: ${payload} Min` });\n    return null;\n}\n\n\n// --- 2. ÜBERWACHUNG DER E-BIKE SENSOR-DATEN (Teilladen-Abschaltautomatik) ---\nif (msgTopic === \"tele/ebike/SENSOR\") {\n    let data = parseJson(payload);\n    if (data && data.ENERGY && data.ENERGY.Current !== undefined) {\n        let currentA = data.ENERGY.Current;\n        let powerW = data.ENERGY.Power;\n        let now = Date.now();\n\n        if (mode === \"PARTIAL\") {\n            let startTime = flow.get(\"ebike_start_time\") || now;\n            let elapsedSinceStartMs = now - startTime;\n            let warmupPeriodMs = 5 * 60 * 1000; \n\n            if (elapsedSinceStartMs < warmupPeriodMs) {\n                let remainingMin = Math.ceil((warmupPeriodMs - elapsedSinceStartMs) / 60000);\n                node.status({ \n                    fill: \"blue\", \n                    shape: \"dot\", \n                    text: `Teilladen (Anlauf): ${currentA}A | Noch ${remainingMin}m` \n                });\n                return null; \n            }\n\n            node.status({ fill: \"blue\", shape: \"dot\", text: `Teilladen aktiv: ${currentA}A (${powerW}W)` });\n\n            if (currentA > 0 && currentA <= cutoffAmps) {\n                flow.set(\"ebike_mode\", \"OFF\");\n                flow.set(\"ebike_start_time\", null);\n                node.status({ fill: \"green\", shape: \"ring\", text: `Teilladen beendet! Strom (${currentA}A) < ${cutoffAmps}A` });\n                return { topic: \"cmnd/ebike/POWER\", payload: \"OFF\" }; \n            }\n        }\n    }\n}\n\n\n// --- 3. ÜBERSCHUSSLADEN ---\nif (msgTopic === \"tele/Unten-WattWaechter_67D580/SENSOR\" && excessActive && mode === \"OFF\") {\n    let data = parseJson(payload);\n    if (data && data[\"\"] && data[\"\"].P !== undefined) {\n        let pGrid = data[\"\"].P; \n        let now = Date.now();\n        let lastCheck = flow.get(\"ebike_last_check\") || 0;\n        let intervalMs = intervalMin * 60 * 1000;\n\n        if (now - lastCheck >= intervalMs) {\n            flow.set(\"ebike_last_check\", now);\n\n            if (pGrid < -60) { \n                node.status({ fill: \"green\", shape: \"dot\", text: `Überschuss AN (P: ${pGrid}W)` });\n                return { topic: \"cmnd/ebike/POWER\", payload: \"ON\" };\n            } else if (pGrid > 20) { \n                node.status({ fill: \"red\", shape: \"ring\", text: `Netzbezug AUS (P: ${pGrid}W)` });\n                return { topic: \"cmnd/ebike/POWER\", payload: \"OFF\" };\n            }\n        }\n    }\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 180,
        "wires": [
            [
                "aa5efb36005e5297"
            ]
        ]
